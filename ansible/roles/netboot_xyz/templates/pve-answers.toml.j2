# Proxmox VE — Auto-Installer Answer File
# Docs: https://pve.proxmox.com/wiki/Automated_Installation
# Hostname + further configuration via Ansible after install

[global]
keyboard = "de-ch"
country = "ch"
fqdn = "pve-node.local"
mailto = ""
timezone = "Europe/Zurich"
root_password = "{{ netboot_root_password }}"
root_ssh_keys = ["{{ netboot_ssh_public_key }}"]

[network]
source = "from-dhcp"

[disk-setup]
# btrfs — no LVM (Proxmox uses btrfs subvolumes directly)
# ⚠️ adjust sda if the disk has a different name (check with lsblk in the installer)
filesystem = "btrfs"
disk_list = ["sda"]
